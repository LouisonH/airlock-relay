{
  "name": "airlock-relay",
  "version": "0.1.5",
  "description": "Credential-isolation relay CLI with platform-aware, fail-closed desktop installer contracts",
  "keywords": [
    "airlock",
    "credential-isolation",
    "ssh",
    "proxy",
    "llm",
    "tauri",
    "macos",
    "windows",
    "linux",
    "cross-platform",
    "security"
  ],
  "homepage": "https://github.com/LouisonH/airlock-relay#readme",
  "bugs": {
    "url": "https://github.com/LouisonH/airlock-relay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LouisonH/airlock-relay.git",
    "directory": "packages/airlock"
  },
  "author": {
    "name": "LouisonH",
    "url": "https://0o0.site"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "airlock-installer": "bin/airlock.js"
  },
  "exports": {
    ".": "./lib/platform.mjs",
    "./platform": "./lib/platform.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/",
    "bin/",
    "dist/",
    "lib/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare:artifact": "node scripts/prepare-artifact.mjs",
    "test": "node --test test/*.test.mjs",
    "test:source": "AIRLOCK_SOURCE_TEST=1 node --test test/*.test.mjs",
    "prepack": "npm run prepare:artifact && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
